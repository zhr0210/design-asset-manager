{
  "version": 2,
  "phase": "15C",
  "scope": "Windows and macOS packaging release flow",
  "windowsNsis": true,
  "macosDmg": true,
  "archMatrix": ["x64", "arm64"],
  "universalMacOptional": true,
  "promotionInvariant": true,
  "unsignedCandidateArtifacts": true,
  "checksumManifest": true,
  "signedCandidateWorkflow": ".github/workflows/release-signed-candidate.yml",
  "signingEnvironmentApproval": true,
  "trustEvidence": true,
  "notarizationEvidence": true,
  "releaseUpdateMetadata": true,
  "releaseWorkflow": ".github/workflows/release-packaging-dry-run.yml",
  "publishEnabled": false,
  "autoUpdateEnabled": false,
  "privacy": {
    "containsSecrets": false,
    "containsRealUserPaths": false
  }
}
