{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.design-asset-manager.invalid/p01/confirm-ai-tag.request.v1.schema.json",
  "$comment": "Proposed additive IPC contract; sender authority is never part of the payload.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "operation": {
      "const": "visual-ai.confirm-tag"
    },
    "requestId": {
      "$ref": "common.v1.schema.json#/definitions/requestId"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "libraryIdentity": {
          "$ref": "common.v1.schema.json#/definitions/opaqueId"
        },
        "generation": {
          "$ref": "common.v1.schema.json#/definitions/opaqueId"
        },
        "assetId": {
          "$ref": "common.v1.schema.json#/definitions/opaqueId"
        },
        "evidenceId": {
          "$ref": "common.v1.schema.json#/definitions/opaqueId"
        },
        "tag": {
          "$ref": "common.v1.schema.json#/definitions/tagLabel"
        }
      },
      "required": [
        "libraryIdentity",
        "generation",
        "assetId",
        "evidenceId",
        "tag"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "operation",
    "requestId",
    "payload"
  ]
}
