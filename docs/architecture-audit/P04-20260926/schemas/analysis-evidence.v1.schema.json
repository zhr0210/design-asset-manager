{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.design-asset-manager.invalid/p04/analysis-evidence.v1.schema.json",
  "$comment": "Proposed documentation only. UTF16 lengths, geometry, cumulative OCR text, scope, claim, recipe eligibility and hashes need semantic/Host validators; NOT_RUN.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "libraryId",
    "assetId",
    "capability",
    "sourceBinding",
    "recipe",
    "profile",
    "execution",
    "quality",
    "attribution",
    "createdAt",
    "value"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "libraryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capability": {
      "enum": [
        "tags",
        "caption",
        "ocr",
        "prompt"
      ]
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetLifecycleRevision",
        "contentKey",
        "previewGeneration",
        "inputArtifactDigest",
        "inputTransformVersion"
      ],
      "properties": {
        "assetLifecycleRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contentKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "previewGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "inputArtifactDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputTransformVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest",
        "modelAlias",
        "weightsDigest",
        "runtimeVersion",
        "providerVersion",
        "identityStatus",
        "parameters",
        "unknownFields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "modelAlias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "weightsDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "providerVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "identityStatus": {
          "enum": [
            "verified-artifacts",
            "declared-only",
            "opaque"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "maxOutputTokens",
            "contextTokens",
            "threads",
            "quantization",
            "hardwareBackend"
          ],
          "properties": {
            "temperature": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxOutputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "contextTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "threads": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "quantization": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "hardwareBackend": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "unknownFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 32
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestGeneration",
        "attemptId",
        "claimEpoch",
        "jobId",
        "physicalInvocationId"
      ],
      "properties": {
        "requestGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "claimEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "jobId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "physicalInvocationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure",
        "language",
        "semantic",
        "eligibility",
        "reasons"
      ],
      "properties": {
        "structure": {
          "const": "valid"
        },
        "language": {
          "enum": [
            "pass",
            "fail",
            "not-assessed",
            "not-applicable"
          ]
        },
        "semantic": {
          "enum": [
            "pass",
            "fail",
            "not-assessed",
            "not-applicable"
          ]
        },
        "eligibility": {
          "enum": [
            "eligible",
            "held"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "maxItems": 16
        }
      }
    },
    "attribution": {
      "enum": [
        "inferred",
        "observed",
        "creative"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "value": {}
  },
  "oneOf": [
    {
      "properties": {
        "capability": {
          "const": "tags"
        },
        "attribution": {
          "const": "inferred"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "labels"
          ],
          "properties": {
            "labels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "maxItems": 30
            }
          }
        }
      }
    },
    {
      "properties": {
        "capability": {
          "const": "caption"
        },
        "attribution": {
          "const": "inferred"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 16000
            }
          }
        }
      }
    },
    {
      "properties": {
        "capability": {
          "const": "prompt"
        },
        "attribution": {
          "const": "creative"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          }
        }
      }
    },
    {
      "properties": {
        "capability": {
          "const": "ocr"
        },
        "attribution": {
          "const": "observed"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "version",
            "recipe",
            "modelSha256",
            "width",
            "height",
            "elapsedMs",
            "threshold",
            "blocks"
          ],
          "properties": {
            "engine": {
              "const": "rapidocr-onnxruntime"
            },
            "version": {
              "const": "1.4.4"
            },
            "recipe": {
              "const": "rapidocr-preview-v1"
            },
            "modelSha256": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "det",
                "cls",
                "rec"
              ],
              "properties": {
                "det": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "cls": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "rec": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1600
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1600
            },
            "elapsedMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 120000
            },
            "threshold": {
              "const": 0.5
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "confidence",
                  "polygon"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 1
                  },
                  "polygon": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              },
              "maxItems": 500
            }
          }
        }
      }
    }
  ]
}
