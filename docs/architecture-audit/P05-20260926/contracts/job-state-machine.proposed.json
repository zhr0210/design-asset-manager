      "to": "failed_final",
      "guard": "known terminal cause; old Evidence remains"
    },
    {
      "from": "validating",
      "event": "possible-remote-execution",
      "to": "remote_outcome_unknown",
      "guard": "dispatch may have occurred; no blind resend"
    },
    {
      "from": "retry_wait",
      "event": "backoff-elapsed",
      "to": "ready",
      "guard": "still permitted and retry bound/deadline valid"
    },
    {
      "from": "paused",
      "event": "resume-review",
      "to": "waiting_condition",
      "guard": "new current authorization; no old token restored"
    },
    {
      "from": "remote_outcome_unknown",
      "event": "provider-proves-not-executed",
      "to": "retry_wait",
      "guard": "current authorization and frozen retry policy permit"
    },
    {
      "from": "remote_outcome_unknown",
      "event": "verified-result-retrievable",
      "to": "ready",
      "guard": "new recovery claim mode; no inference send permitted"
    },
    {
      "from": "remote_outcome_unknown",
      "event": "resolve-final",
      "to": "failed_final",
      "guard": "explicit resolution or definitive provider evidence"
    },
    {
      "from": "queued",
      "event": "pause-or-close",
      "to": "paused",
      "guard": "revoke claim; retain any unknown physical outcome independently"
    },
    {
      "from": "queued",
      "event": "last-subscriber-cancel",
      "to": "cancelled",
      "guard": "revoke claim; committed success cannot be undone"
    },
    {
      "from": "queued",
      "event": "new-generation-or-content",
      "to": "superseded",
      "guard": "slot fence advanced; old callback cannot commit"
    },
