{
  "status": "proposed_NOT_RUN",
  "states": [
    "queued",
    "waiting_condition",
    "ready",
    "running",
    "validating",
    "retry_wait",
    "paused",
    "remote_outcome_unknown",
    "succeeded",
    "failed_final",
    "cancelled",
    "superseded"
  ],
  "terminalStates": [
    "succeeded",
    "failed_final",
    "cancelled",
    "superseded"
  ],
  "transientStates": [
    "committing"
  ],
  "transitions": [
    {
      "from": "queued",
      "event": "evaluate-missing-condition",
      "to": "waiting_condition",
      "guard": "Host active; no dispatch"
    },
    {
      "from": "queued",
      "event": "preflight-ready",
      "to": "ready",
      "guard": "conditions observed, not permanent authority"
    },
    {
      "from": "waiting_condition",
      "event": "conditions-ready",
      "to": "ready",
      "guard": "all current conditions rechecked"
    },
    {
      "from": "ready",
      "event": "condition-lost",
      "to": "waiting_condition",
      "guard": "no dispatch"
    },
    {
      "from": "ready",
      "event": "claim",
      "to": "running",
      "guard": "Host lease/session + job/slot CAS + fresh token"
    },
    {
      "from": "running",
      "event": "complete-response",
      "to": "validating",
      "guard": "current attempt and bounded full response"
    },
    {
      "from": "validating",
      "event": "commit",
      "to": "succeeded",
      "guard": "synchronous Evidence+Job+Outbox transaction; committing transient only"
    },
    {
      "from": "validating",
      "event": "quality-held",
      "to": "failed_final",
      "guard": "history evidence+QUALITY_HELD+Outbox atomic; current retained"
    },
    {
      "from": "running",
      "event": "known-retryable-failure",
      "to": "retry_wait",
      "guard": "same generation, policy budget/deadline allow; prior attempt invalidated"
    },
    {
      "from": "running",
      "event": "definite-final-failure",
      "to": "failed_final",
      "guard": "known terminal cause; old Evidence remains"
    },
    {
      "from": "running",
      "event": "possible-remote-execution",
      "to": "remote_outcome_unknown",
      "guard": "dispatch may have occurred; no blind resend"
    },
    {
      "from": "validating",
      "event": "known-retryable-failure",
      "to": "retry_wait",
      "guard": "same generation, policy budget/deadline allow; prior attempt invalidated"
    },
    {
      "from": "validating",
