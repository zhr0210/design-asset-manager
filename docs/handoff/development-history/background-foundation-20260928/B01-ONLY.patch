+const defaults=():BackgroundPolicy=>({enabled:false,capabilities:{tags:true,caption:true,ocr:true},revision:0})
+const safeRevision=(n:unknown)=>typeof n==='number'&&Number.isSafeInteger(n)&&n>=0&&n<=Number.MAX_SAFE_INTEGER
