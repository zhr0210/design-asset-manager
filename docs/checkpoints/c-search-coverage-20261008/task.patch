new file mode 100644
index e69de29..52d6993 100644
--- /dev/null
+++ b/.scratch/c-search-20261008/readback.mjs
@@ -0,0 +1,90 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import assert from 'node:assert/strict'
+import {createHash} from 'node:crypto'
+import {createRequire} from 'node:module'
+
+const require = createRequire(path.resolve('package.json')), Database = require('better-sqlite3')
+const stage = process.argv[2]
+assert.ok(['before', 'paused', 'repair-baseline', 'prepared', 'reuse-before', 'reuse-after', 'before-reopen', 'after-reopen'].includes(stage))
+const task = path.resolve('.scratch/c-search-20261008'), library = path.resolve('.scratch/c-search-20261007/library')
+await fs.mkdir(path.join(task, 'evidence'), {recursive: true})
+const sha = bytes => createHash('sha256').update(bytes).digest('hex')
+const signature = value => sha(JSON.stringify(value))
+const registry = JSON.parse(await fs.readFile(path.join(library, '.dam/.dam-asset-retrieval.json'), 'utf8'))
+const owned = (name, prefix) => {assert.match(name, new RegExp(`^${prefix}-[a-f0-9-]{36}\\.sqlite$`)); return path.join(library, '.dam', name)}
+const main = new Database(path.join(library, '.dam/library.sqlite'), {readonly: true, fileMustExist: true})
+let mainState
+try {
+  main.exec('BEGIN')
+  assert.equal(main.pragma('integrity_check', {simple: true}), 'ok')
+  assert.deepEqual(main.pragma('foreign_key_check'), [])
+  const tables = ['assets', 'asset_tags', 'basic_analysis_requests', 'basic_analysis_attempts',
+    'basic_analysis_evidence', 'background_analysis_executions', 'background_analysis_execution_history']
+  mainState = Object.fromEntries(tables.map(table => {const rows = main.prepare(`SELECT * FROM ${table} ORDER BY rowid`).all();
+    return [table, {count: rows.length, sha256: signature(rows)}]}))
+  main.exec('ROLLBACK')
+} finally {if (main.inTransaction) main.exec('ROLLBACK'); main.close()}
+const canonical = new Database(owned(registry.canonical, 'asset-vectors'), {readonly: true, fileMustExist: true})
+const index = new Database(owned(registry.index, 'asset-vector-index'), {readonly: true, fileMustExist: true})
+let derived
+try {
+  canonical.exec('BEGIN'); index.exec('BEGIN')
+  assert.equal(canonical.pragma('integrity_check', {simple: true}), 'ok')
+  assert.equal(index.pragma('integrity_check', {simple: true}), 'ok')
+  const space = String(canonical.prepare("SELECT value FROM meta WHERE key='active'").pluck().get())
+  const vectors = canonical.prepare('SELECT * FROM vectors ORDER BY space,id,view').all()
+  const jobs = canonical.prepare('SELECT * FROM jobs ORDER BY id').all()
+  derived = {space, canonicalVectors: vectors.length, vectorSignatures: Object.fromEntries(vectors.map(row =>
+    [JSON.stringify([row.space, row.id, row.view]), signature(row)])), canonicalSha256: signature(vectors),
+    jobSignatures: Object.fromEntries(jobs.map(row => [row.id, signature(row)])), jobsSha256: signature(jobs),
+    jobs: jobs.map(({id, state, completed, total, failed, error}) => ({id, state, completed, total, failed, error})),
+    running: jobs.filter(row => row.state === 'running').length,
+    currentIndexed: Number(index.prepare('SELECT COUNT(*) FROM vectors WHERE space=?').pluck().get(space)), index: registry.index}
+  index.exec('ROLLBACK'); canonical.exec('ROLLBACK')
+} finally {if (index.inTransaction) index.exec('ROLLBACK'); if (canonical.inTransaction) canonical.exec('ROLLBACK'); index.close(); canonical.close()}
+const media = {}
+async function walk(directory) {for (const entry of await fs.readdir(directory, {withFileTypes: true})) {
+  const file = path.join(directory, entry.name)
+  assert.ok(!entry.isSymbolicLink(), 'No external media traversal')
+  if (entry.isDirectory()) await walk(file)
+  else if (entry.isFile()) media[path.relative(library, file).split(path.sep).join('/')] = sha(await fs.readFile(file))
+}}
+await walk(path.join(library, 'Originals')); await walk(path.join(library, '.dam/required-previews'))
+const result = {at: new Date().toISOString(), stage, main: mainState, media, derived}
+assert.equal(mainState.assets.count, 165)
+assert.equal(derived.running, 0)
+if (stage === 'before') assert.equal(derived.currentIndexed, 45)
+else {
+  const before = JSON.parse(await fs.readFile(path.join(task, 'evidence/before.json'), 'utf8'))
+  assert.deepEqual(result.main, before.main, 'No changes to original metadata, human edits, tags or full analysis audit')
+  assert.deepEqual(result.media, before.media, 'All original and preview bytes remain intact')
+  assert.equal(derived.space, before.derived.space)
+  const vectorBaseline = ['prepared', 'reuse-before', 'reuse-after', 'before-reopen', 'after-reopen'].includes(stage)
+    ? JSON.parse(await fs.readFile(path.join(task, 'evidence/repair-baseline.json'), 'utf8')) : before
+  if (stage === 'repair-baseline') {
+    result.legacyCanonicalRowsChanged = Object.entries(before.derived.vectorSignatures)
+      .filter(([key, hash]) => derived.vectorSignatures[key] !== hash).map(([key]) => key)
+    assert.ok(derived.currentIndexed > 45 && derived.currentIndexed < 165)
+  } else for (const [key, hash] of Object.entries(vectorBaseline.derived.vectorSignatures)) assert.equal(derived.vectorSignatures[key], hash,
+    'Compatible prior vector record must be reused without replacement')
+  for (const [key, hash] of Object.entries(before.derived.jobSignatures)) assert.equal(derived.jobSignatures[key], hash,
+    'Prior generation job must remain unchanged')
+  if (!['paused', 'repair-baseline'].includes(stage)) assert.equal(derived.currentIndexed, 165)
+  if (stage === 'reuse-after') {
+    const prior = JSON.parse(await fs.readFile(path.join(task, 'evidence/reuse-before.json'), 'utf8'))
+    assert.equal(derived.canonicalSha256, prior.derived.canonicalSha256, 'Explicit full compatible reuse must preserve the whole canonical store')
+    for (const [key, hash] of Object.entries(prior.derived.jobSignatures)) assert.equal(derived.jobSignatures[key], hash)
+  }
+  if (stage === 'after-reopen') {
+    const closed = JSON.parse(await fs.readFile(path.join(task, 'evidence/before-reopen.json'), 'utf8'))
+    assert.equal(derived.canonicalSha256, closed.derived.canonicalSha256, 'Reopen must not regenerate vectors')
+    assert.equal(derived.jobsSha256, closed.derived.jobsSha256, 'Reopen must not create or restart generation')
+  }
+}
+await fs.writeFile(path.join(task, `evidence/${stage}.json`), JSON.stringify(result, null, 2) + '\n')
+console.log(JSON.stringify({stage, assets: mainState.assets.count, protectedFiles: Object.keys(media).length,
+  currentIndexed: derived.currentIndexed, canonicalVectors: derived.canonicalVectors, running: derived.running,
+  jobs: derived.jobs.length, checks: stage === 'before' ? 'baseline captured, readonly' : stage === 'repair-baseline'
+    ? 'metadata/media/full prior audit intact; legacy changed canonical records captured as repair baseline, readonly'
+    : 'metadata/media/full audit/prior vectors and jobs preserved, readonly'}))
diff --git a/.scratch/c-search-20261008/run-readback.mjs b/.scratch/c-search-20261008/run-readback.mjs
new file mode 100644
index e69de29..3144923 100644
--- /dev/null
+++ b/.scratch/c-search-20261008/run-readback.mjs
@@ -0,0 +1,17 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import {createRequire} from 'node:module'
+import {spawn} from 'node:child_process'
+const stage = process.argv[2]
+if (!['before', 'paused', 'repair-baseline', 'prepared', 'reuse-before', 'reuse-after', 'before-reopen', 'after-reopen'].includes(stage)) throw new Error('STAGE_DENIED')
+const require = createRequire(path.resolve('package.json')), electron = require('electron')
+const child = spawn(electron, [path.resolve('.scratch/c-search-20261008/readback.mjs'), stage], {
+  windowsHide: true, shell: false, env: {...process.env, ELECTRON_RUN_AS_NODE: '1'}, stdio: ['ignore', 'pipe', 'pipe']})
+const chunks = []
+child.stdout.on('data', bytes => chunks.push(bytes)); child.stderr.on('data', bytes => chunks.push(bytes))
+const code = await new Promise((resolve, reject) => {child.once('error', reject); child.once('close', resolve)})
+const output = Buffer.concat(chunks).toString('utf8')
+await fs.mkdir('.scratch/c-search-20261008/validation', {recursive: true})
+await fs.writeFile(`.scratch/c-search-20261008/validation/${stage}.log`, output)
+console.log(output.trim())
+process.exitCode = code ?? 1
