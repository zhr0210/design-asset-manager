+        if (live.current)
+            setError(e instanceof Error ? e.message : '交付失败。');
+    }
+    finally {
+        if (live.current)
+            setBusy(false);
+    } };
+    return <section className="work-file-handoff" aria-label="交付文件"><h3>交付文件</h3><p>交付独立副本；库中原件保持。接收应用读完后再清理。</p>
