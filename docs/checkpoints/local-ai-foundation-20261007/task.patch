+        const images:Buffer[]=[]
+        for(const [name,sha] of [['astronaut.jpg','e54bf41617611bb18a83e8b8dd5ab49ac32b6b9fa25be5b507343da78ea29b9c'],['flag.jpg','80c6f7565f45f9e51c4c0e288521136dad77e14c4b739af746c46858ecda4ead']]){
