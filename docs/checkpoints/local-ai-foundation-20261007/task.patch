+      CREATE TABLE vectors(space TEXT NOT NULL,id TEXT NOT NULL,view TEXT NOT NULL,input_sha TEXT NOT NULL,vector BLOB NOT NULL,created_at TEXT NOT NULL,PRIMARY KEY(space,id,view));
