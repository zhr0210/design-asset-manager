+    try { await fs.mkdir(root, { mode: 0o700 }); await fs.writeFile(path.join(root, MARKER), 'dam-gguf-native-v1', { flag: 'wx', mode: 0o600 }) }
+    catch (error) { if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error }
