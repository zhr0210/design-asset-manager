+      await fs.readFile(path.join(root, MARKER), 'utf8') !== 'dam-gguf-native-v1') throw Error('NATIVE_RUNTIME_STORAGE_INVALID')
+  }
+  async function checkedDirectory(record: PackageRecord, published = false) {
+    await ensureStore()
