+import {test} from 'node:test'
+import assert from 'node:assert/strict'
+import fs from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+import {validateModelArtifactPackage} from '../src/main/model-library/model-artifact-format-validation.internal'
+
+await test('SentencePiece proto2 defaults are legal; unknown fields and vocabularies beyond the declared consumer bound remain rejected',async()=>{
+  const root=await fs.mkdtemp(path.join(os.tmpdir(),'dam-piece-proto-')),file=path.join(root,'tokenizer.model')
+  // ModelProto.pieces { piece: "x" }; optional score defaults to 0, type to NORMAL.
+  const piece=Buffer.from([0x0a,0x03,0x0a,0x01,0x78])
+  const validate=async(bytes:Buffer,pieceEntryLimit?:number)=>{await fs.writeFile(file,bytes);return validateModelArtifactPackage({files:[{
+    relativePath:'tokenizer.model',role:'tokenizer',format:'sentencepiece',sizeBytes:bytes.length,readableFile:file,sentencePieceEntryLimit:pieceEntryLimit}]})}
+  try{
+    assert.equal(await validate(piece),true)
+    assert.equal(await validate(Buffer.from([0x0a,0x05,0x0a,0x03,0xef,0xbb,0xbf])),true,
+      'A vocabulary entry may itself be U+FEFF; decoding token data must preserve it')
+    assert.equal(await validate(Buffer.from([0x0a,0x05,0x0a,0x01,0x78,0x38,0x01])),false,'Unrecognized piece fields do not become executable or accepted metadata')
+    const larger=Buffer.concat(Array.from({length:100001},()=>piece))
+    assert.equal(await validate(larger),false)
+    assert.equal(await validate(larger,256000),true)
+    assert.equal(await validate(larger,100000),false)
+  }finally{await fs.rm(root,{recursive:true,force:true})}
+})
