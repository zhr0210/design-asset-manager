@@ -0,0 +1,53 @@
+import assert from 'node:assert/strict'
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import {randomUUID} from 'node:crypto'
+import Database from 'better-sqlite3'
+import {createManagedVisionRuntime} from '../../src/main/services/ai-runtime/managed-vision-runtime'
+import {createManagedModelLibrary} from '../../src/main/model-library-workspace/managed-model-library'
+import {createManagedGgufPackages} from '../../src/main/services/ai-runtime/managed-gguf-packages'
+import {createVisualAdmission} from '../../src/main/visual-ai/visual-admission'
+import {createNewInstallAppSettingsDefaults} from '../../src/main/services/settings/settings-defaults.builder'
+import {DAM_BUILD_IDENTITY} from '../../src/shared/build-identity.generated'
+
+// Runtime Adapter seam authorized by the implementation spec. Reuse ONLY the
+// public inventory's actual validated CPU plan, never fabricated qualification.
+// This test runs offline and owns its App database and inference process.
+const profile=path.resolve('.scratch/wc01-real-model-library-20261005/run-U4eFuo/profile-04')
+const root=path.resolve('.scratch/local-ai-implementation-20261006/cold-cancel-'+randomUUID())
+await fs.mkdir(root)
+const source=new Database(path.join(profile,'app-state/app-state.sqlite'),{readonly:true,fileMustExist:true}),db=new Database(path.join(root,'app.sqlite'))
+const denied=async()=>{throw Error('NETWORK_DENIED_IN_COLD_CANCEL_TEST')}
+const admission=createVisualAdmission({policy:{mode:'normal',reserveFraction:.1}})
+const packages=createManagedGgufPackages({database:db,root:path.join(profile,'managed-gguf-runtime'),fetch:denied,changed(){}})
+const models=createManagedModelLibrary({database:db,root:path.join(profile,'managed-models'),runner:path.resolve('out/main/ai-service/tools/managed_vision_worker.py'),fetch:denied,
+  selectModel:async()=>null,selectPython:async()=>null,reserve:(id,signal)=>admission.reserveResident(id,128*1024**2,signal),changed(){},admission})
+db.prepare('INSERT OR REPLACE INTO managed_model_store VALUES(1,?)').run(source.prepare('SELECT identity FROM managed_model_store WHERE singleton=1').pluck().get())
+const row=source.prepare("SELECT id,record FROM managed_model_entries WHERE json_extract(record,'$.artifact.modelId')='qwen3-vl-2b-instruct' AND json_extract(record,'$.artifact.gguf.languageQuantization')='Q4_K_M'").get() as {id:string;record:string}|undefined
+assert.ok(row,'Actual approved model inventory is required')
+db.prepare('INSERT INTO managed_model_entries VALUES(?,?)').run(row.id,row.record)
+for(const r of source.prepare('SELECT variant,record FROM managed_gguf_packages').all() as Array<{variant:string;record:string}>)db.prepare('INSERT INTO managed_gguf_packages VALUES(?,?)').run(r.variant,r.record)
+source.close()
+const configuration=models.verifiedConfigurations(row.id).find(c=>c.native?.plan.mode==='cpu')
+assert.ok(configuration,'Actual CPU image qualification is required')
+let settings=createNewInstallAppSettingsDefaults()
+const runtime=createManagedVisionRuntime({database:db,runner:path.resolve('out/main/ai-service/tools/managed_vision_worker.py'),models,ggufPackages:packages,admission,
+  settings:{getSettings:()=>settings,saveSettings:value=>(settings={...settings,...value})} as any,selectModel:async()=>null,selectPython:async()=>null,changed(){}})
+db.prepare('INSERT INTO managed_vision_runtime VALUES(1,?)').run(JSON.stringify({...configuration,enabled:true}))
+try{
+  const restoring=runtime.recheck()
+  assert.equal(runtime.status().state,'checking')
+  await runtime.drain();await restoring
+  assert.equal(runtime.status().state,'inactive','A cancelled cold check must remain eligible for a complete new check')
+  assert.equal(runtime.backgroundReadiness().ready,true,'Cancellation must not permanently disable the already trusted model')
+  assert.equal(admission.resourceStatus().residentBytes,0,'No process exists at this cancelled inspection boundary')
+  assert.equal(models.verifiedConfigurations(row.id).find(c=>c.fingerprint===configuration.fingerprint)?.fingerprint,configuration.fingerprint)
+  // A new work unit still performs full artifact checks and actual image
+  // qualification; cancellation is not a success or a qualification shortcut.
+  await runtime.recheck()
+  assert.equal(runtime.status().state,'ready')
+  assert.ok(runtime.status().measurement!.peakRamBytes>0)
+  await runtime.drain();assert.equal(admission.resourceStatus().residentBytes,0)
+  const result={candidateBuild:DAM_BUILD_IDENTITY.buildId,scope:'real public 2B CPU offline Runtime Adapter; internal acceptance seam',afterCancellation:'inactive and recheck required',recheck:'actual image qualification passed',resource:admission.resourceStatus()}
+  await fs.writeFile(path.join(root,'result.json'),JSON.stringify(result,null,2));console.log(JSON.stringify({result:'COLD_CANCEL_AND_REAL_OFFLINE_RECHECK',evidence:path.relative(process.cwd(),root)}))
+}finally{await runtime.drain();admission.invalidate();db.close()}
